# Steelbore Standard §6.5: every text file is stored LF-terminated.
* text=auto eol=lf

# Steelbore Standard §6.5: binary assets are declared, not auto-detected.
*.ttf binary
*.otf binary
*.ppm binary

# The release archive (`cargo xtask dist`) leaves out the package
# definitions and release manifests, which record its checksum, so recording
# it changes nothing the archive holds, and the flake and NixOS module, which
# build from a checkout. Keep in step with dist::EXPORT_IGNORED.
/packaging/ export-ignore
/flake.nix export-ignore
/flake.lock export-ignore
/doc/releases/ export-ignore
