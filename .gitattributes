# Steelbore Standard §6.5: every text file is stored LF-terminated.
* text=auto eol=lf

# Steelbore Standard §6.5: binary assets are declared, not auto-detected.
*.ttf binary
*.otf binary
*.ppm binary

# The release archive (`cargo xtask dist`) leaves out the files that record
# its checksum, and the release manifests, so recording it changes nothing
# the archive holds.
/packaging/default.nix export-ignore
/packaging/guix.scm export-ignore
/packaging/PKGBUILD export-ignore
/doc/releases/ export-ignore
